# Project Atlas environment template.
#
#   cp .env.example .env
#
# IMPORTANT: a blank value is NOT the same as "use the default". Pydantic parses
# "" and fails on any typed field, so only variables that are safe to leave
# empty (optional secrets) appear blank below. Every tuning knob is omitted on
# purpose and falls back to the value in app/config.py; add one back only when
# you intend to override it, and always with a real value.
#
# Never commit .env - it is gitignored.

# --- LLM providers (at least one required for answer generation) ------------
# Ordered preference. A provider without its key is skipped, so listing extras
# is harmless - and listing more than one is what stops a single free tier's
# daily cap from taking generation down mid-demo. Every endpoint is
# OpenAI-compatible. Known names: siliconflow, nvidia, modelscope, gemini,
# groq, openrouter, mistral, huggingface, ollama, llm7.
#   ...,llm7 is an unauthenticated public endpoint kept last so a demo survives
#   every keyed tier being exhausted. It has no SLA and no stated data handling,
#   so drop it for anything carrying real content.
ATLAS_LLM_PROVIDERS=groq,openrouter,gemini,llm7

# Per-provider keys. Fill in whichever you have; blank ones are skipped.
GROQ_API_KEY=                     # console.groq.com/keys       30 RPM, tight daily token cap
OPENROUTER_API_KEY=               # openrouter.ai/keys          20 RPM, 50 RPD, ":free" models
GEMINI_API_KEY=                   # aistudio.google.com/apikey  15 RPM, 1500 RPD
# NVIDIA_API_KEY=                 # build.nvidia.com            40 RPM, 10000 RPD
# SILICONFLOW_API_KEY=            # siliconflow.cn              1000 RPM, 50000 TPM
# MODELSCOPE_API_KEY=             # modelscope.cn               2000 RPD
# MISTRAL_API_KEY=  HF_TOKEN=  OLLAMA_API_KEY=  LLM7_API_KEY=

# Model per provider. Omit to use the registry default in app/llm.py.
GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_MODEL=gemini-flash-latest
# ATLAS_LLM_MODEL=               # one model pinned across every provider
# ATLAS_LLM_TIMEOUT_SECONDS=30
# Free endpoints return transient 429/503 constantly. Each provider is retried
# this many times before the router moves on; 1 disables retrying.
# ATLAS_LLM_ATTEMPTS_PER_PROVIDER=3
# ATLAS_LLM_RETRY_BACKOFF_SECONDS=0.6

# --- Datastores (required) -------------------------------------------------
# Port 5433 matches docker-compose.yml, which avoids clashing with a local
# PostgreSQL already on 5432. Must be the async driver (postgresql+asyncpg).
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5433/atlas
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Frontend / CORS ------------------------------------------------------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8001

# --- Optional: Supabase-hosted deployment ---------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Authentication --------------------------------------------------------
# Off by default. Turning it on makes every project route require a bearer
# token, so create the first account BEFORE flipping it or nobody can sign in:
#   python3 scripts/create_user.py --email you@example.com --project-id <uuid> --role admin
# With this off, project_id is data scoping only - anyone who can reach the
# URL can read and write every project.
# ATLAS_AUTH_ENABLED=false
# ATLAS_AUTH_TOKEN_TTL_SECONDS=28800

# Required once ATLAS_AUTH_ENABLED is true - it signs session tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# --- Local runtime --------------------------------------------------------
ATLAS_ENVIRONMENT=local
ATLAS_LOG_LEVEL=INFO

# --- Frequently overridden settings (uncomment to change) -----------------
# Retrieval backend. "sentence_transformer" (default) is semantic;
# "local_hash" is deterministic, offline and NOT semantic.
# ATLAS_EMBEDDING_BACKEND=sentence_transformer
# ATLAS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# ATLAS_EMBEDDING_DIMENSIONS=384        # must match the model's width
# ATLAS_INDEX_VERSION=3                 # bump forces reindex of older documents
# ATLAS_QDRANT_COLLECTION=atlas_chunks
# ATLAS_INGESTION_TIMEOUT_SECONDS=300
# ATLAS_MAX_UPLOAD_BYTES=52428800
# ATLAS_UPLOAD_DIR=./uploads
# ATLAS_GRAPH_DIR=./graphs
# ATLAS_AUTO_CREATE_SCHEMA=false        # true only for throwaway local databases

# --- Deployment (set by the platform, e.g. Render) ------------------------
# PORT=8000
# WEB_CONCURRENCY=1
# FORWARDED_ALLOW_IPS=127.0.0.1
