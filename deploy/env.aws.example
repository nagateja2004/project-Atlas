# Environment for the single-instance AWS deployment.
#
#   cp deploy/env.aws.example .env.aws     # then fill it in
#
# .env.aws is gitignored (.gitignore ignores .env.*). It lives ON THE INSTANCE
# and is never committed. Your local .env does not travel to AWS.
#
# Used as: docker compose -f docker-compose.aws.yml --env-file .env.aws up -d
#
# A blank value here is NOT "use the default" for the guarded variables - the
# compose file fails fast on the five that must be set.

# --- Public address -------------------------------------------------------
# ATLAS_SITE_ADDRESS is the Caddy site address.
#   - Leave it as :80 for a first plain-HTTP smoke test.
#   - For free automatic HTTPS with no domain purchase, use sslip.io with your
#     Elastic IP, dots replaced by dashes:  13-51-2-3.sslip.io
#     Caddy then gets a real Let's Encrypt certificate for it.
ATLAS_SITE_ADDRESS=:80
ATLAS_ACME_EMAIL=you@example.com

# The browser-facing origin. Must match ATLAS_SITE_ADDRESS, including scheme.
#   http://<elastic-ip>          while ATLAS_SITE_ADDRESS is :80
#   https://13-51-2-3.sslip.io   once a hostname is set
ATLAS_PUBLIC_URL=http://CHANGE-ME

# --- Datastores (self-hosted on this instance) ----------------------------
# Generate both, do not reuse a value from anywhere else:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
QDRANT_API_KEY=
# POSTGRES_DB=atlas
# POSTGRES_USER=atlas

# --- LLM providers --------------------------------------------------------
# At least GROQ_API_KEY is required. Configure a second provider too: free
# tiers have small daily caps and a single exhausted provider otherwise takes
# generation down until it resets.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# ATLAS_LLM_PROVIDERS=groq,openrouter,gemini
# GROQ_MODEL=openai/gpt-oss-120b

# --- Optional -------------------------------------------------------------
# ATLAS_LOG_LEVEL=INFO
# Set to local_hash only as a last resort: it boots without model weights but
# retrieval becomes lexical-only and will not match paraphrased questions.
# ATLAS_EMBEDDING_BACKEND=sentence_transformer

# --- Set by the GitHub Actions deploy; leave unset for a local build ------
# When present, the instance pulls these prebuilt images instead of building.
# Building the torch image on a 1 GB instance is not viable.
# ATLAS_API_IMAGE=ghcr.io/<owner>/<repo>-api:latest
# ATLAS_WEB_IMAGE=ghcr.io/<owner>/<repo>-web:latest
